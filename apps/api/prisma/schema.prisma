// Licorería — Control de Inventario y Facturación
// Modelo de datos: 15 tablas
// Convención: snake_case en DB (@map), camelCase en TypeScript

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum SaleStatus {
  ISSUED
  VOIDED
}

enum PurchaseStatus {
  REGISTERED
  CANCELLED
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  VOID_REVERSAL
}

enum ReferenceType {
  PURCHASE
  SALE
  ADJUSTMENT
}

enum BackupType {
  MANUAL
  SCHEDULED
}

// ─────────────────────────── Auth / Roles ───────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role               Role                @relation(fields: [roleId], references: [id])
  purchases          Purchase[]
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  backups            Backup[]

  @@map("users")
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────── Catálogos ───────────────────────────

model Category {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?

  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  sku              String   @unique
  name             String
  categoryId       String   @map("category_id") @db.Uuid
  imageKey         String?  @map("image_key")
  currentCost      Decimal  @default(0) @map("current_cost") @db.Decimal(12, 2)
  marginPercentage Decimal  @map("margin_percentage") @db.Decimal(6, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate          Decimal  @map("tax_rate") @db.Decimal(5, 2)
  currentStock     Int      @default(0) @map("current_stock")
  minStock         Int      @default(0) @map("min_stock")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category           Category            @relation(fields: [categoryId], references: [id])
  purchaseDetails    PurchaseDetail[]
  saleDetails        SaleDetail[]
  inventoryMovements InventoryMovement[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  contactName String? @map("contact_name")
  phone       String?
  email       String?
  address     String?
  isActive    Boolean @default(true) @map("is_active")

  purchases Purchase[]

  @@map("suppliers")
}

model Customer {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  documentId String? @map("document_id")
  phone      String?
  email      String?
  address    String?
  isActive   Boolean @default(true) @map("is_active")

  sales Sale[]

  @@index([documentId])
  @@map("customers")
}

// ─────────────────────────── Compras ───────────────────────────

model Purchase {
  id           String         @id @default(uuid()) @db.Uuid
  supplierId   String         @map("supplier_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  purchaseDate DateTime       @default(now()) @map("purchase_date") @db.Timestamptz(6)
  total        Decimal        @db.Decimal(12, 2)
  status       PurchaseStatus @default(REGISTERED)

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  details  PurchaseDetail[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseDetail {
  id         String  @id @default(uuid()) @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_details")
}

// ─────────────────────────── Ventas / Facturación ───────────────────────────

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  invoiceNumber String     @unique @map("invoice_number")
  customerId    String     @map("customer_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  saleDate      DateTime   @default(now()) @map("sale_date") @db.Timestamptz(6)
  subtotal      Decimal    @db.Decimal(12, 2)
  taxTotal      Decimal    @map("tax_total") @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  status        SaleStatus @default(ISSUED)

  customer Customer     @relation(fields: [customerId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  details  SaleDetail[]

  @@index([saleDate])
  @@index([customerId])
  @@index([userId])
  @@map("sales")
}

model SaleDetail {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_details")
}

// ─────────────────────────── Inventario (Kardex) ───────────────────────────

model InventoryMovement {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  type          MovementType
  quantity      Int
  referenceType ReferenceType @map("reference_type")
  referenceId   String        @map("reference_id") @db.Uuid
  balanceAfter  Int           @map("balance_after")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  userId        String        @map("user_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ─────────────────────────── Auditoría / Backups ───────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Backup {
  id        String     @id @default(uuid()) @db.Uuid
  filename  String
  sizeBytes BigInt     @map("size_bytes")
  createdBy String     @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  type      BackupType @default(MANUAL)

  creator User @relation(fields: [createdBy], references: [id])

  @@map("backups")
}
