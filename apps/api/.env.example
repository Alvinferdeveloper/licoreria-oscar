# ─── Base de datos ───
DATABASE_URL=postgresql://licoreria:licoreria_dev@localhost:5432/licoreria_db

# ─── JWT ───
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh
JWT_REFRESH_EXPIRES=7d

# ─── App ───
PORT=3000
TZ=UTC
CORS_ORIGIN=http://localhost:5173

# ─── Supabase Storage (solo backend, imágenes de producto) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ─── Respaldos (directorio donde se guardan los .dump) ───
BACKUP_DIR=backups

# ─── Seed ───
SEED_ADMIN_EMAIL=admin@licoreria.local
SEED_ADMIN_PASSWORD=Admin123*
